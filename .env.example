# API keys resolve PER VENDOR, with a shared fallback:
#   1. <VENDOR>_API_KEY  — used for that vendor
#   2. LLM_API_KEY       — fallback for any vendor without its own
#
# Name a key after the vendor it belongs to. A key parked in the generic
# LLM_API_KEY slot is offered to *every* vendor, and a token for one provider
# cannot authenticate at another's endpoint.
#
# Read from the repo root regardless of your working directory.

ZAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# LLM_API_KEY=            # optional shared fallback

# --- custom vendor (a model at a provider not built in) ---------------------
# Declare its OpenAI-compatible endpoint and key; then use `acme:model-slug`
# as the model ref in the CLI or dashboard.
# ACME_BASE_URL=https://api.acme.example/v1
# ACME_API_KEY=
